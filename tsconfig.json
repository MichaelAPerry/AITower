{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@aitower/sim": ["packages/sim/src/index.ts"],
      "@aitower/content": ["packages/content/src/index.ts"],
      "@aitower/render": ["packages/render/src/index.ts"],
      "@aitower/ui": ["packages/ui/src/index.ts"],
      "@aitower/audio": ["packages/audio/src/index.ts"],
      "@aitower/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "tools/*/src", "vitest.config.ts"]
}
